# Daftar env var yang dikenali test ini. File ini hanya dokumentasi:
# test TIDAK membaca file .env secara otomatis. Isi nilainya lewat terminal
# (contoh di README) atau lewat GitHub Secrets di CI. Jangan commit nilai asli.

# Pilih env: dev | staging | prod   (default: dev)
TEST_ENV=dev

# Opsional: override base URL dari config/environments.ts
BASE_URL=
API_BASE_URL=

# Kredensial API (Restful-Booker). Wajib untuk staging & prod.
API_USERNAME=
API_PASSWORD=

# Kredensial UI (Sauce Demo). Wajib untuk staging & prod.
UI_USERNAME=
UI_PASSWORD=

# Opsional: akun yang sengaja dikunci, untuk test "user terkunci".
# Bila kosong di staging/prod, test tersebut di-skip.
UI_LOCKED_USERNAME=
UI_LOCKED_PASSWORD=
