{
  "name": "simple-test",
  "version": "1.0.0",
  "description": "Pengujian automation QA sederhana dengan Playwright (TypeScript) dan Page Object Model untuk Sauce Demo.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test tests/e2e",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "e2e", "page-object-model", "saucedemo"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.28.1",
    "@types/node": "^16.18.0",
    "typescript": "~5.4.5"
  }
}
