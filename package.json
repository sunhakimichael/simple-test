{
  "name": "simple-test",
  "version": "1.0.0",
  "description": "Pengujian automation QA sederhana dengan Playwright (TypeScript) dan Page Object Model untuk Sauce Demo.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:login": "playwright test tests/ui/login.spec.ts",
    "test:sorting": "playwright test tests/ui/product-sorting.spec.ts",
    "test:checkout": "playwright test tests/ui/checkout-form-validation.spec.ts tests/ui/e2e",
    "test:e2e": "playwright test tests/ui/e2e",
    "test:api:booking": "playwright test tests/api/booking.spec.ts",
    "test:api:patch": "playwright test tests/api/booking-patch.spec.ts",
    "test:api:search": "playwright test tests/api/booking-search.spec.ts",
    "test:api:contract": "playwright test tests/api/booking-contract.spec.ts",
    "test:api:guard": "playwright test tests/api/env-guard.spec.ts",
    "test:dev": "node scripts/run-tests.js dev",
    "test:staging": "node scripts/run-tests.js staging",
    "test:prod": "node scripts/run-tests.js prod",
    "demo:1": "playwright test --project=chromium --headed --workers=1 -g \"login berhasil|user yang terkunci|Price .low to high.|E2E: Login\"",
    "demo:2": "playwright test tests/ui/login.spec.ts tests/ui/product-sorting.spec.ts tests/ui/e2e --headed --workers=1",
    "demo:3": "playwright test tests/api/auth.spec.ts tests/api/booking.spec.ts",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "e2e", "page-object-model", "saucedemo"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.28.1",
    "@types/node": "^16.18.0",
    "typescript": "~5.4.5"
  }
}
